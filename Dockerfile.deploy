# First stage: Build the Node.js application
FROM node:20-alpine3.19 AS build-stage
WORKDIR /app
COPY ./frontend/i2pdm2-demo-cam/package*.json ./
RUN npm install
COPY ./frontend/i2pdm2-demo-cam .
# Deploying under a real domain: pass these so links/API calls point at it
# instead of the localhost defaults baked into src/config.ts / vite.config.ts, e.g.:
#   docker build -f Dockerfile.deploy \
#     --build-arg VITE_API_BASE_URL=https://<your-domain>/<path>/api/v1 \
#     --build-arg VITE_BASE_PATH=/<path>/ .
ARG VITE_API_BASE_URL
ARG VITE_BASE_PATH
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_BASE_PATH=$VITE_BASE_PATH
# Build the app for production
RUN npm run build

# Second stage: Serve with Nginx
FROM nginx:stable-alpine AS production-stage
# Copy built files from the first stage
COPY --from=build-stage /app/dist /usr/share/nginx/html
# COPY ./frontend/nginx.conf /etc/nginx/conf.d/default.conf
CMD ["nginx", "-g", "daemon off;"]


