# Copy to .env.local for `npm run dev` / `npm run build` outside Docker.
# (Docker-based testing instead sets these via docker-compose.yaml's build.args.)
# Leave unset to keep production behavior (see src/config.ts / vite.config.ts defaults).

# Backend API base URL
VITE_API_BASE_URL=http://localhost:28000/api/v1

# Reverse-proxy base path for this app's own assets/router. Use / for local testing.
VITE_BASE_PATH=/
